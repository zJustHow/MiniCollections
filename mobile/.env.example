# EXPO_PUBLIC_API_URL=https://your-api.example.com

# Optional: public web origin for Universal Links and share URLs (same host as the SPA)
# EXPO_PUBLIC_WEB_URL=https://app.example.com

# Physical device dev: use your machine LAN IP, e.g.
# EXPO_PUBLIC_API_URL=http://192.168.1.42:8080

# Allow plain HTTP on Android release/preview builds (local API only)
# EXPO_PUBLIC_ALLOW_CLEARTEXT=true
