{
  "family": "minicollections",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "${ECS_EXECUTION_ROLE_ARN}",
  "taskRoleArn": "${ECS_TASK_ROLE_ARN}",
  "containerDefinitions": [
    {
      "name": "minicollections",
      "image": "000000000000.dkr.ecr.us-east-1.amazonaws.com/minicollections:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8080,
          "hostPort": 8080,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "SPRING_PROFILES_ACTIVE", "value": "prod" },
        { "name": "PORT", "value": "8080" },
        { "name": "INIT_DB", "value": "${INIT_DB}" },
        { "name": "DATABASE_URL", "value": "${DATABASE_URL}" },
        { "name": "DATABASE_PORT", "value": "5432" },
        { "name": "DATABASE_USERNAME", "value": "postgres" },
        { "name": "REDIS_HOST", "value": "${REDIS_HOST}" },
        { "name": "REDIS_PORT", "value": "6379" },
        { "name": "REDIS_SSL_ENABLED", "value": "${REDIS_SSL_ENABLED}" },
        { "name": "ELASTICSEARCH_URIS", "value": "${ELASTICSEARCH_URIS}" },
        { "name": "ELASTICSEARCH_ENABLED", "value": "true" },
        { "name": "ELASTICSEARCH_REINDEX_ON_STARTUP", "value": "false" },
        { "name": "S3_ENABLED", "value": "true" },
        { "name": "S3_ENDPOINT", "value": "https://s3.amazonaws.com" },
        { "name": "S3_REGION", "value": "${AWS_REGION}" },
        { "name": "S3_BUCKET", "value": "${S3_BUCKET}" },
        { "name": "S3_PUBLIC_BASE_URL", "value": "${S3_PUBLIC_BASE_URL}" },
        { "name": "ADMIN_EMAIL", "value": "${ADMIN_EMAIL}" },
        { "name": "ADMIN_NAME", "value": "${ADMIN_NAME}" },
        { "name": "ADMIN_LOCALE", "value": "${ADMIN_LOCALE}" },
        { "name": "MAIL_HOST", "value": "${MAIL_HOST}" },
        { "name": "MAIL_PORT", "value": "${MAIL_PORT}" },
        { "name": "MAIL_USERNAME", "value": "${MAIL_USERNAME}" }
      ],
      "secrets": [
        {
          "name": "JWT_SECRET",
          "valueFrom": "${APP_SECRETS_ARN}:JWT_SECRET::"
        },
        {
          "name": "DATABASE_PASSWORD",
          "valueFrom": "${APP_SECRETS_ARN}:DATABASE_PASSWORD::"
        },
        {
          "name": "S3_ACCESS_KEY",
          "valueFrom": "${APP_SECRETS_ARN}:S3_ACCESS_KEY::"
        },
        {
          "name": "S3_SECRET_KEY",
          "valueFrom": "${APP_SECRETS_ARN}:S3_SECRET_KEY::"
        },
        {
          "name": "ADMIN_PASSWORD",
          "valueFrom": "${APP_SECRETS_ARN}:ADMIN_PASSWORD::"
        },
        {
          "name": "MAIL_PASSWORD",
          "valueFrom": "${APP_SECRETS_ARN}:MAIL_PASSWORD::"
        },
        {
          "name": "ELASTICSEARCH_USERNAME",
          "valueFrom": "${APP_SECRETS_ARN}:ELASTICSEARCH_USERNAME::"
        },
        {
          "name": "ELASTICSEARCH_PASSWORD",
          "valueFrom": "${APP_SECRETS_ARN}:ELASTICSEARCH_PASSWORD::"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/minicollections",
          "awslogs-region": "${AWS_REGION}",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
