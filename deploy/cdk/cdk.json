{
  "app": "mvn -e -q compile exec:java -Dexec.mainClass=com.zjusthow.minicollections.cdk.MiniCollectionsCdkApp",
  "watch": {
    "include": ["**"],
    "exclude": [
      "README.md",
      "cdk*.json",
      "target",
      "pom.xml",
      "src/test"
    ]
  },
  "context": {
    "@aws-cdk/aws-lambda:recognizeLayerVersion": true,
    "@aws-cdk/core:checkSecretUsage": true,
    "@aws-cdk/core:target-partitions": ["aws", "aws-cn"],
    "appName": "minicollections",
    "usePublicSubnets": "true",
    "desiredCount": "0",
    "databaseUrl": "REPLACE_WITH_RDS_ENDPOINT",
    "redisHost": "REPLACE_WITH_REDIS_ENDPOINT",
    "elasticsearchUris": "REPLACE_WITH_OPENSEARCH_ENDPOINT",
    "s3Bucket": "REPLACE_WITH_S3_BUCKET",
    "s3PublicBaseUrl": "REPLACE_WITH_PUBLIC_MEDIA_URL",
    "githubRepository": "OWNER/REPO",
    "certificateArn": ""
  }
}
