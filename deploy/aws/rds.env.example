# Copy to deploy/aws/rds.env (gitignored) and fill in production values.
#
#   cp deploy/aws/rds.env.example deploy/aws/rds.env

# --- RDS (required for import scripts) ---
RDS_HOST=minicollections-db.xxxx.us-west-2.rds.amazonaws.com
RDS_PASSWORD=your-rds-postgres-password
RDS_USER=postgres
RDS_DB=minicollections

# --- AWS / ECS (required for import-prod-brands-via-ecs.sh when RDS is private VPC) ---
AWS_REGION=us-west-2
ECS_CLUSTER=minicollections
ECS_SERVICE=minicollections
S3_BUCKET=minicollections-media-717373613148

# Optional: use Secrets Manager instead of RDS_PASSWORD in ECS task
# APP_SECRETS_ARN=arn:aws:secretsmanager:us-west-2:ACCOUNT:secret:minicollections/app-XXXX

# Optional: S3 URL prefix for prepare-prod-sql
# NEW_PREFIX=https://minicollections-media-717373613148.s3.us-west-2.amazonaws.com
