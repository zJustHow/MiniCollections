# Copy to .env and adjust per machine. dev.sh loads backend/.env before bootRun.
#
# Docker Postgres (docker-compose.yml maps localhost:5432):
# DATABASE_URL=localhost
# DATABASE_PORT=5432
# DATABASE_USERNAME=postgres
# DATABASE_PASSWORD=secret
#
# S3_PUBLIC_BASE_URL must be the URL browsers use to load images (scheme + host + port + bucket path).
# Upload, DB seed URLs, and delete all rely on the same prefix within each environment.
#
# Local (default — matches seed SQL and MinIO port mapping in docker-compose.yml):
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=minicollections-media
S3_PUBLIC_BASE_URL=http://localhost:9000/minicollections-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_ENABLED=true

# First admin on production deploy (spring.profiles.active=prod). Skipped when any admin already exists.
# If ADMIN_EMAIL is already registered, only ROLE_ADMIN is granted; ADMIN_PASSWORD is ignored.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=Admin
# ADMIN_LOCALE=en-US

# Production example (set via host env / secrets — do not commit real values):
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_BUCKET=your-prod-bucket
# S3_PUBLIC_BASE_URL=https://media.yourdomain.com
