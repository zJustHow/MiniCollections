{
  "analysis": {
    "char_filter": {
      "remove_hyphens": {
        "type": "pattern_replace",
        "pattern": "-",
        "replacement": ""
      },
      "normalize_scale_ratio": {
        "type": "pattern_replace",
        "pattern": "/",
        "replacement": ":"
      }
    },
    "normalizer": {
      "scale_normalizer": {
        "type": "custom",
        "char_filter": ["normalize_scale_ratio"],
        "filter": ["lowercase"]
      },
      "lowercase_normalizer": {
        "type": "custom",
        "filter": ["lowercase"]
      }
    },
    "filter": {
      "word_delimiter_catenate": {
        "type": "word_delimiter_graph",
        "catenate_all": true,
        "preserve_original": true
      },
      "flatten_graph": {
        "type": "flatten_graph"
      }
    },
    "analyzer": {
      "english_text_index": {
        "type": "custom",
        "char_filter": ["remove_hyphens"],
        "tokenizer": "keyword",
        "filter": ["word_delimiter_catenate", "flatten_graph", "lowercase"]
      },
      "english_text_search": {
        "type": "custom",
        "char_filter": ["remove_hyphens"],
        "tokenizer": "whitespace",
        "filter": ["lowercase"]
      }
    }
  }
}
